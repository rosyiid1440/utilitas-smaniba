<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-3xl font-semibold text-gray-800">Manajemen Log & Data</h1>
        <p class="mt-2 text-gray-600">Kelola log autentikasi dan data accounting untuk menjaga performa database.</p>
    </div>
</div>

<% if (message) { %>
    <div class="mt-6 p-4 rounded-lg <%= message.type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>"
        role="alert">
        <%= message.text %>
    </div>
    <% } %>

        <!-- Log Autentikasi Section -->
        <div class="mt-6 bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">Log Autentikasi (radpostauth)</h2>
                    <p class="text-sm text-gray-600 mt-1">Riwayat upaya login berhasil dan gagal</p>
                    <p class="text-sm font-medium text-blue-600 mt-1">Total: <%= totalLogs.toLocaleString('id-ID') %>
                            record</p>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-2">
                <form action="/auth-logs/cleanup" method="POST" class="flex gap-2"
                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus log autentikasi lama?');">
                    <select name="retention_days"
                        class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="7">Hapus > 7 hari</option>
                        <option value="30" selected>Hapus > 30 hari</option>
                        <option value="60">Hapus > 60 hari</option>
                        <option value="90">Hapus > 90 hari</option>
                    </select>
                    <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-orange-600 rounded-lg hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
                        <i class="bi bi-trash mr-1"></i> Bersihkan Log Lama
                    </button>
                </form>
                <form action="/auth-logs/clear-all" method="POST"
                    onsubmit="return confirm('PERINGATAN: Ini akan menghapus SEMUA log autentikasi! Apakah Anda yakin?');">
                    <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        <i class="bi bi-trash-fill mr-1"></i> Hapus Semua
                    </button>
                </form>
            </div>
        </div>

        <!-- Data Accounting Section -->
        <div class="mt-6 bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">Data Accounting (radacct)</h2>
                    <p class="text-sm text-gray-600 mt-1">Riwayat session koneksi WiFi (biasanya paling besar)</p>
                    <p class="text-sm font-medium text-purple-600 mt-1">Total: <%=
                            totalAcctRecords.toLocaleString('id-ID') %> record</p>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-2">
                <form action="/auth-logs/cleanup-accounting" method="POST" class="flex gap-2"
                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus data accounting lama? Ini akan menghapus riwayat koneksi WiFi.');">
                    <select name="retention_days"
                        class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <option value="7">Hapus > 7 hari</option>
                        <option value="30" selected>Hapus > 30 hari</option>
                        <option value="60">Hapus > 60 hari</option>
                        <option value="90">Hapus > 90 hari</option>
                        <option value="180">Hapus > 6 bulan</option>
                    </select>
                    <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-orange-600 rounded-lg hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
                        <i class="bi bi-trash mr-1"></i> Bersihkan Data Lama
                    </button>
                </form>
                <form action="/auth-logs/clear-all-accounting" method="POST"
                    onsubmit="return confirm('PERINGATAN KERAS: Ini akan menghapus SEMUA riwayat koneksi WiFi! Apakah Anda SANGAT yakin?');">
                    <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        <i class="bi bi-trash-fill mr-1"></i> Hapus Semua
                    </button>
                </form>
            </div>
        </div>

        <!-- Log Autentikasi Table -->


        <div class="mt-6 bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Tabel Log Autentikasi Terbaru</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full whitespace-nowrap">
                    <thead class="bg-gray-50">
                        <tr class="text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            <th class="p-4">Waktu</th>
                            <th class="p-4">Username</th>
                            <th class="p-4">Status</th>
                            <th class="p-4">Keterangan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% if (logs && logs.length> 0) { %>
                            <% logs.forEach(log=> { %>
                                <tr class="text-gray-700 text-sm">
                                    <td class="p-4">
                                        <%= new Date(log.authdate).toLocaleString('id-ID', { dateStyle: 'medium' ,
                                            timeStyle: 'short' }) %>
                                    </td>
                                    <td class="p-4 font-medium text-gray-900">
                                        <%= log.username %>
                                    </td>
                                    <td class="p-4">
                                        <% if (log.reply==='Access-Accept' ) { %>
                                            <span
                                                class="px-2 py-1 font-semibold leading-tight text-green-700 bg-green-100 rounded-full">Berhasil</span>
                                            <% } else { %>
                                                <span
                                                    class="px-2 py-1 font-semibold leading-tight text-red-700 bg-red-100 rounded-full">Gagal</span>
                                                <% } %>
                                    </td>
                                    <td class="p-4 text-gray-600">
                                        <%= log.reason || '-' %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="p-6 text-center text-gray-500">Belum ada log
                                                autentikasi.
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (totalPages> 1) { %>
            <nav class="flex justify-center mt-6" aria-label="Pagination">
                <% const window=2; const baseQuery=``; // Tidak ada filter untuk saat ini %>
                    <a href="?page=<%= currentPage - 1 %><%= baseQuery %>"
                        class="px-3 py-2 mx-1 rounded-md text-sm font-medium <%= currentPage === 1 ? 'text-gray-400 bg-gray-200 pointer-events-none' : 'text-gray-700 bg-white hover:bg-gray-50' %>">&laquo;</a>
                    <% let lastRenderedPage=0; for(let i=1; i <=totalPages; i++) { const shouldRender=(i===1) ||
                        (i===totalPages) || (i>= currentPage - window && i <= currentPage + window); if (shouldRender) {
                            if (i>
                            lastRenderedPage + 1) { %><span
                                class="px-3 py-2 mx-1 rounded-md text-sm font-medium text-gray-500 bg-white">...</span>
                            <% } %>
                                <a href="?page=<%= i %><%= baseQuery %>"
                                    class="px-3 py-2 mx-1 rounded-md text-sm font-medium <%= i === currentPage ? 'text-white bg-blue-600 z-10' : 'text-gray-700 bg-white hover:bg-gray-50' %>">
                                    <%= i %>
                                </a>
                                <% lastRenderedPage=i; } } %>
                                    <a href="?page=<%= currentPage + 1 %><%= baseQuery %>"
                                        class="px-3 py-2 mx-1 rounded-md text-sm font-medium <%= currentPage === totalPages ? 'text-gray-400 bg-gray-200 pointer-events-none' : 'text-gray-700 bg-white hover:bg-gray-50' %>">&raquo;</a>
            </nav>
            <% } %>